# jxnu-admin 管理面板配置（模板）。
# 真实文件放 ~/apps/jxnu-admin/admin.env，chmod 600，不进仓库。
# install-admin.sh 首次运行时会自动生成（含随机密码）。

# ── 监听 ──
# 只绑回环地址：面板不暴露公网，访问走 SSH 隧道（见 deploy/README.md「管理面板」章节）。
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8790

# ── 认证（必填）──
# 登录密码；install-admin.sh 会生成随机 32 位十六进制串。改后重启 jxnu-admin 生效。
ADMIN_PASSWORD=changeme

# ── 路径 ──
# 仓库 clone 位置（repo_op 的 git / build_data.py 在此执行）
REPO_DIR=/home/guiguisocute/better-jxnu-elective-system
# 三个服务的 env 文件（面板白名单键编辑；均应为 600 权限）
KKAP_ENV=/home/guiguisocute/apps/jxnu-kkap/kkap.env
SYNC_ENV=/home/guiguisocute/apps/jxnu-kkap/sync.env
LIVE_ENV=/home/guiguisocute/apps/jxnu-live/live.env
# 与每小时同步互斥用的 flock 锁文件
SYNC_LOCK=/home/guiguisocute/apps/jxnu-kkap/sync.lock

# ── Cloudflare Pages API（可空；不配则 /ai 页只显示创建 token 指引）──
# Account ID：dash.cloudflare.com 任意域概览页右侧栏可复制
CF_ACCOUNT_ID=
# 自定义 API Token：My Profile → API Tokens → Create Custom Token，
# 权限 Account / Cloudflare Pages / Edit，Account Resources 选账号
CF_API_TOKEN=
# Pages 项目名
CF_PAGES_PROJECT=jxnu-elective-plus
