[Unit]
Description=JXNU course data sync through the Go backend
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/better-jxnu-elective-system
EnvironmentFile=%h/apps/jxnu-backend/backend.env
ExecStart=%h/apps/jxnu-backend/jxnu-backend sync --scheduled
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
