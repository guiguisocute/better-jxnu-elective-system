[Unit]
Description=JXNU elective admin panel (ops WebUI, loopback only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 仓库目录作为工作目录：repo_op 的 git/build_data.py 都在这里跑
WorkingDirectory=%h/better-jxnu-elective-system
EnvironmentFile=%h/apps/jxnu-admin/admin.env
ExecStart=/usr/bin/python3 %h/apps/jxnu-admin/admin_service.py
# git push 走 deploy key（与 kkap-schedule.service 相同约定）
Environment=GIT_SSH_COMMAND=ssh -i %h/.ssh/id_ed25519 -o IdentitiesOnly=yes
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
