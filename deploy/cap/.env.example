# Copy to .env on the VPS. Never commit the real dashboard key.
CAP_ADMIN_KEY=replace-with-at-least-32-random-characters

# Cap 监听地址。留空即 127.0.0.1，只有同机反代能访问。
# 反代与 Cap 不同机时（后端在校园网、nginx 在公网边缘），填 Cap 这台机器上
# 反代能到达的那个地址（例如覆盖网 IP）。不要填 0.0.0.0：Cap 控制台在根路径。
CAP_BIND_ADDR=127.0.0.1

# Comma-separated browser origins allowed to request challenges.
CAP_CORS_ORIGIN=https://xk.betterjxnu.cn,https://xk.jxnu-publish.asia,https://test.better-jxnu-elective-system.pages.dev,http://localhost:5173,http://127.0.0.1:5173
