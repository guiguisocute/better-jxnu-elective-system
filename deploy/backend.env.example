# JXNU Go 后端的敏感配置。真实文件放 ~/apps/jxnu-backend/backend.env，权限 600。
# 普通业务选项（默认阶段、三个学期、刷新频率）在 config.json / 管理面板维护。

PUBLIC_ADDR=127.0.0.1:8787
LIVE_ADDR=127.0.0.1:8788
ADMIN_ADDR=127.0.0.1:8790
REPO_DIR=/home/guiguisocute/better-jxnu-elective-system
BACKEND_CONFIG=/home/guiguisocute/apps/jxnu-backend/config.json
BACKEND_ENV_FILE=/home/guiguisocute/apps/jxnu-backend/backend.env
SYNC_LOCK=/home/guiguisocute/apps/jxnu-backend/sync.lock

# 管理面板密码（安装脚本首次部署会自动生成）
ADMIN_PASSWORD=changeme

# 教务只读查询账号；用于实时学号课表和教学班容量。
XK_USERNAME=
XK_PASSWORD=

# Cloudflare Pages Function 请求 /live/student-record 时携带的共享密钥。
LIVE_SECRET=

# AI 配置页管理 Pages production 环境变量所需；未填写时可在面板内一次性验证并安全保存。
# Token 权限：Account / Cloudflare Pages / Edit。
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_PAGES_PROJECT=jxnu-elective-plus
