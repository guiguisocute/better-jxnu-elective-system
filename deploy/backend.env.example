# JXNU Go 后端的敏感配置。真实文件放 ~/apps/jxnu-backend/backend.env，权限 600。
# 普通业务选项（默认阶段、三个学期、刷新频率）在 config.json / 管理面板维护。
#
# 下面每一项都能在管理面板的「部署配置」页填（含改管理密码、教务账号、Cloudflare
# 四件套），填完即写回本文件。首次安装用 deploy/install-backend.sh 生成即可，
# 不必手抄这份模板。把 <你的用户名> 换成 VPS 上跑服务的那个用户。

PUBLIC_ADDR=127.0.0.1:8787
LIVE_ADDR=127.0.0.1:8788
ADMIN_ADDR=127.0.0.1:8790
REPO_DIR=/home/<你的用户名>/better-jxnu-elective-system
BACKEND_CONFIG=/home/<你的用户名>/apps/jxnu-backend/config.json
BACKEND_ENV_FILE=/home/<你的用户名>/apps/jxnu-backend/backend.env
SYNC_LOCK=/home/<你的用户名>/apps/jxnu-backend/sync.lock

# 管理面板密码（安装脚本首次部署会自动生成）
ADMIN_PASSWORD=changeme

# 教务只读查询账号；用于实时学号课表和教学班容量。
XK_USERNAME=
XK_PASSWORD=

# Cloudflare Pages Function 请求 /live/student-record 时携带的共享密钥。
LIVE_SECRET=

# Cloudflare。同一个 Token 要同时具备 Account / Cloudflare Pages / Edit（AI 配置页写
# Pages 环境变量）与 Account / D1 / Edit（评价、举报、人机验证开关都存 D1）。
# 四项都没有内置默认值 —— 它们指向某一个具体账号的资源，写死默认值会让 fork 出来的
# 部署指向别人的项目和数据库。留空即可，进面板「部署配置」页一次性验证并保存。
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_PAGES_PROJECT=
CF_D1_DATABASE_ID=
